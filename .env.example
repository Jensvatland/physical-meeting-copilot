# Local Meeting Core (shared by gateway + MCP).
# Optional — this path is already the built-in default.
# MEETING_CORE_DB=~/.physical-meeting-copilot/meetings.db
MEETING_GATEWAY_HOST=127.0.0.1
MEETING_GATEWAY_PORT=8787
# MEETING_GATEWAY_DEBUG=0

# Profile labels only in v0.1 — they do not switch to real China models yet
# MEETING_PROFILE=global  # or china

# Optional providers — never mandatory for smoke / sim MVP
# OPENAI_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# QWEN_BASE_URL=
# QWEN_API_KEY=
# FUNASR_ENABLED=0
# MEETING_CORE_POSTGRES_DSN=
