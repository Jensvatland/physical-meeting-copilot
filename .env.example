# Local Meeting Core (shared by gateway + MCP)
MEETING_CORE_DB=~/.physical-meeting-copilot/meetings.db
MEETING_GATEWAY_HOST=127.0.0.1
MEETING_GATEWAY_PORT=8787
# Required only when binding gateway to a non-loopback host (no auth yet):
# MEETING_ALLOW_INSECURE_BIND=1
# MEETING_GATEWAY_DEBUG=0
# MEETING_PROFILE=global  # or china
# MEETING_ASR=sim         # or funasr (stub until runtime is wired)

# Optional providers — never mandatory
# OPENAI_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# QWEN_BASE_URL=
# QWEN_API_KEY=
# FUNASR_ENABLED=0
# MEETING_CORE_POSTGRES_DSN=
